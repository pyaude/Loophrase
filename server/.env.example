# ─── 数据库 ──────────────────────────────────────────────
# sqlite（默认，无需额外服务）或 postgresql（高并发场景）
# DATABASE_URL=sqlite:///data/versions.db
#
# PostgreSQL 示例（未来扩展时启用）:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/loophrase
DATABASE_URL=sqlite:///data/versions.db

# ─── 管理 ────────────────────────────────────────────────
# 管理接口鉴权 Token（发布/删除版本时需要）
# 生成方式: openssl rand -hex 32
# 此 Token 需与 GitHub Secrets 中的 UPDATE_ADMIN_TOKEN 保持一致
ADMIN_TOKEN=

# ─── 服务 ────────────────────────────────────────────────
# 服务监听端口
PORT=8000

# 单次上传最大体积（字节，默认 500MB）
# MAX_UPLOAD_SIZE=524288000
